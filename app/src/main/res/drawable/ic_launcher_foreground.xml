<?xml version="1.0" encoding="utf-8"?>
<!-- A location pin with two dots inside: two people, one place. All artwork stays inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ground shadow -->
    <path
        android:fillColor="#40000000"
        android:pathData="M42,82a12,3 0 1,0 24,0a12,3 0 1,0 -24,0z" />

    <!-- pin body -->
    <path android:pathData="M54,25C44.06,25 36,33.06 36,43C36,56.5 54,76 54,76C54,76 72,56.5 72,43C72,33.06 63.94,25 54,25Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="25"
                android:endX="54"
                android:endY="76"
                android:type="linear">
                <item android:offset="0" android:color="#FFEDE5FF" />
                <item android:offset="1" android:color="#FFB69DF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- inner disc -->
    <path
        android:fillColor="#FF1C1730"
        android:pathData="M43,43a11,11 0 1,0 22,0a11,11 0 1,0 -22,0z" />

    <!-- the two of you -->
    <path
        android:fillColor="#FFF2B8D2"
        android:pathData="M44.8,43a3.8,3.8 0 1,0 7.6,0a3.8,3.8 0 1,0 -7.6,0z" />
    <path
        android:fillColor="#FFEDE5FF"
        android:pathData="M55.6,43a3.8,3.8 0 1,0 7.6,0a3.8,3.8 0 1,0 -7.6,0z" />
</vector>
