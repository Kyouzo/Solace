sdk.dir=/path/to/Android/Sdk
# Publishable/anonymous key only. Never add the Supabase service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
# Optional: CARTO basemaps API key for HD retina map tiles + a real dark map style.
# Leave empty to use plain OpenStreetMap tiles (works, but softer on high-density screens).
MAP_API_KEY=
